# Copy to ".env" if you need to change these. Both are optional.

# Where the dev server forwards /api requests (the FastAPI backend)
VITE_PROXY_TARGET=http://127.0.0.1:8001

# Base URL used by the browser. "/api" works with the dev proxy above.
# For a separately hosted backend use a full URL, e.g. https://soc.example.com/api (CORS must allow it).
VITE_API_BASE=/api
