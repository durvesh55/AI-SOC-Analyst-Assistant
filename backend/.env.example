# Copy this file to ".env" and change the values. NEVER commit ".env".
MONGO_URI=mongodb://localhost:27017
MONGO_DB=ai_soc_assistant

# Generate a strong secret, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of allowed browser origins (the React dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Used only by `python -m app.seed` (development accounts + sample alerts)
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ANALYST_PASSWORD=Analyst@12345
